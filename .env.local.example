# Copy this file to .env.local and fill in the values below.

# Which LLM drafts the slide text/caption: "ollama" (free, runs on this
# machine) or "anthropic" (cloud, costs money per use, but works from
# anywhere — including a Vercel deployment).
#
# IMPORTANT: "ollama" only works when Ollama is running on the SAME machine
# as this app. That's fine for local dev, but a Vercel deployment cannot
# reach your/your client's laptop — set this to "anthropic" before deploying
# to Vercel (see README.md).
LLM_PROVIDER=ollama

# --- Ollama (used when LLM_PROVIDER=ollama) ---
# Install: https://ollama.com. Then pull a model that supports tool calling,
# e.g. `ollama pull qwen2.5-coder:7b` (llama3.1 and mistral-nemo also work),
# and make sure `ollama serve` is running before using the app.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# --- Anthropic (used when LLM_PROVIDER=anthropic) ---
# Get a key at https://console.anthropic.com/settings/keys — billed based on
# usage (one API call per "Draft copy" click), a real ongoing cost.
ANTHROPIC_API_KEY=

# --- Canva Connect (used by the "Edit in Canva" button) ---
# One-time setup:
#   1. Go to https://www.canva.com/developers/integrations and create an integration
#   2. Under "Authentication", add this redirect URL:
#        http://127.0.0.1:3000/api/canva/callback
#   3. Under "Scopes", enable: design:content:write, design:meta:read
#   4. Copy the Client ID and Client Secret below, restart the app
# The first time you click "Edit in Canva", a popup asks you to approve the
# connection; after that it's one click.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://127.0.0.1:3000/api/canva/callback
